# ── Required secrets ──────────────────────────────────────────────
# Redis connection (Railway injects REDIS_URL automatically via plugin)
REDIS_URL=redis://localhost:6379

# Admin panel access token — generate one: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# ── Optional secrets ──────────────────────────────────────────────
# Anthropic API key (used for LLM enrichment, pairwise scoring, & walk-up backfill scoring)
# If unset: the backfill worker is disabled, and unscored pairs fall back to the
# deterministic 0-100 heuristic_pair_score (app/scoring.py) so matching still works
ANTHROPIC_API_KEY=

# ── Event configuration ──────────────────────────────────────────
# URL slug identifying the event — prefixes all Redis keys and view routes
EVENT_SLUG=climate-week-2026
# Display name shown on the projector screen and badges
EVENT_NAME=SF Climate Week Dosido
BASE_URL=http://localhost:8000  # Used for badge QR code URLs — set to your custom domain in production

# Matching defaults
ROUND_DURATION_MINUTES=8  # Length of each networking round
TOTAL_ROUNDS=10           # Number of rounds the solver plans for

# LLM provider: "claude" (Anthropic API), "ollama" (local model), or "none"
# (deterministic stub enrichment + heuristic scores, no API calls)
LLM_PROVIDER=claude
# Ollama model and server URL — only used when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# ── Set by platform (do not set manually) ────────────────────────
# PORT — Railway/Heroku inject this automatically
